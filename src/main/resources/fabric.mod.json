{
  "schemaVersion": 1,
  "id": "luminrt",
  "version": "${version}",
  "name": "LuminRT",
  "description": "LuminRT extends Iris Vulkan with ray tracing for Minecraft 26.3. Currently supports RayQuery only.",
  "authors": ["slmpc"],
  "license": "GPL-3.0-only",
  "contact": {
    "sources": "https://github.com/slmpc/Lumin-RT",
    "issues": "https://github.com/slmpc/Lumin-RT/issues"
  },
  "environment": "client",
  "mixins": ["luminrt.mixins.json"],
  "entrypoints": {
    "client": ["com.github.slmpc.luminrt.LuminRT"],
    "sodium:config_api_user": ["com.github.slmpc.luminrt.config.LuminRTSodiumConfig"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "iris": "${iris_version}",
    "sodium": "0.9.x"
  }
}
